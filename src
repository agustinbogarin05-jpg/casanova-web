// recharts 3 turned Tooltip from a generic class, `Tooltip<TValue, TName>`, into a plain function fixed
// to `TooltipProps<ValueType, NameType>`, and its formatter now receives `TValue | undefined`. On
// recharts 2 (what every tutorial and model learned) the `(v: number) =>` formatter and
// `(label: string) =>` labelFormatter an agent writes inferred their type parameters; on 3.x they fail
// TS2322 under strictFunctionTypes. Vite and tsconfig alias "recharts" here: everything from the real
// package, plus Tooltip declared with recharts 2's generic callback signatures. Nothing changes at
// runtime (as on 2.x, a missing datum still reaches the formatter as undefined). Raw package:
// "recharts-upstream".
/* oxlint-disable react/only-export-components -- `export *` re-exports upstream components */
import type { ReactNode } from "react";
import {
  Tooltip as UpstreamTooltip,
  type TooltipPayloadEntry,
  type TooltipProps as UpstreamTooltipProps,
  type TooltipValueType,
} from "recharts-upstream";

export * from "recharts-upstream";

type NameType = string | number;
type UpstreamProps = UpstreamTooltipProps<TooltipValueType, NameType>;
type TooltipPayload = Parameters<NonNullable<UpstreamProps["labelFormatter"]>>[1];

/** recharts 2's Formatter: `value` is `TValue`, inferred from the callback the caller writes. */
export type TooltipFormatter<TValue extends TooltipValueType = TooltipValueType, TName extends NameType = NameType> = (
  value: TValue,
  name: TName,
  item: TooltipPayloadEntry,
  index: number,
  payload: TooltipPayload,
) => ReactNode | [ReactNode, ReactNode];

export function Tooltip<
  TValue extends TooltipValueType = TooltipValueType,
  TName extends NameType = NameType,
  TLabel = ReactNode,
>(
  props: Omit<UpstreamTooltipProps<TValue, TName>, "formatter" | "labelFormatter"> & {
    formatter?: TooltipFormatter<TValue, TName>;
    labelFormatter?: (label: TLabel, payload: TooltipPayload) => ReactNode;
  },
) {
  // The type parameters only narrow what the callbacks declare; recharts 2 erased them the same way.
  return <UpstreamTooltip {...(props as UpstreamProps)} />;
}

import { useSyncExternalStore } from "react";

/** Pedido del cliente (carrito): se guarda en el dispositivo (localStorage), sin cuenta. */
const KEY = "casanova:pedido";
const MAX_QTY = 99;

export interface CartItem {
  id: string;
  qty: number;
}

function read(): CartItem[] {
  try {
    const v: unknown = JSON.parse(localStorage.getItem(KEY) ?? "[]");
    if (!Array.isArray(v)) return [];
    return v.filter(
      (x): x is CartItem => typeof x?.id === "string" && Number.isInteger(x?.qty) && x.qty > 0,
    );
  } catch {
    return [];
  }
}

let items: CartItem[] = read();
let ids: string[] = items.map((i) => i.id);
let count = items.reduce((s, i) => s + i.qty, 0);
let panelOpen = false;
const listeners = new Set<() => void>();
const emit = () => listeners.forEach((l) => l());

function save(next: CartItem[]) {
  items = next;
  ids = next.map((i) => i.id);
  count = next.reduce((s, i) => s + i.qty, 0);
  try {
    localStorage.setItem(KEY, JSON.stringify(next));
  } catch {
    /* modo privado: queda solo en memoria */
  }
  emit();
}

function subscribe(listener: () => void) {
  listeners.add(listener);
  const onStorage = (e: StorageEvent) => {
    if (e.key === KEY) {
      items = read();
      ids = items.map((i) => i.id);
      count = items.reduce((s, i) => s + i.qty, 0);
      emit();
    }
  };
  window.addEventListener("storage", onStorage); // sincroniza pestañas abiertas
  return () => {
    listeners.delete(listener);
    window.removeEventListener("storage", onStorage);
  };
}

export const favorites = {
  /** Suma una unidad (o agrega el producto con cantidad 1). */
  add(id: string) {
    const cur = items.find((i) => i.id === id);
    save(cur ? items.map((i) => (i.id === id ? { ...i, qty: Math.min(i.qty + 1, MAX_QTY) } : i)) : [...items, { id, qty: 1 }]);
  },
  setQty(id: string, qty: number) {
    if (qty <= 0) return save(items.filter((i) => i.id !== id));
    save(items.map((i) => (i.id === id ? { ...i, qty: Math.min(qty, MAX_QTY) } : i)));
  },
  remove: (id: string) => save(items.filter((i) => i.id !== id)),
  clear: () => save([]),
  setPanel(open: boolean) {
    panelOpen = open;
    emit();
  },
};

export const useFavoriteIds = (): string[] => useSyncExternalStore(subscribe, () => ids);
export const useCartItems = (): CartItem[] => useSyncExternalStore(subscribe, () => items);
export const useCartCount = (): number => useSyncExternalStore(subscribe, () => count);
export const useFavoritesPanel = (): boolean => useSyncExternalStore(subscribe, () => panelOpen);

import { useCallback } from "react";
import { useLocation, useNavigate, useSearchParams } from "react-router-dom";

export interface ScrollState {
  scrollTo?: string;
}

export function scrollToId(id: string) {
  document.getElementById(id)?.scrollIntoView({ behavior: "smooth", block: "start" });
}

/** Search (`q`) and category (`cat`) live in the URL so header, catalog and back-button stay in sync. */
export function useCatalogParams() {
  const [params, setParams] = useSearchParams();
  const location = useLocation();
  const navigate = useNavigate();
  const onHome = location.pathname === "/";
  const q = onHome ? (params.get("q") ?? "") : "";
  const cat = onHome ? (params.get("cat") ?? "") : "";

  const update = useCallback(
    (changes: Record<string, string | null>, opts: { scroll?: boolean } = {}) => {
      const next = new URLSearchParams(onHome ? params : undefined);
      for (const [key, value] of Object.entries(changes)) {
        if (value) next.set(key, value);
        else next.delete(key);
      }
      if (onHome) {
        setParams(next, {
          replace: true,
          preventScrollReset: true,
          state: opts.scroll ? ({ scrollTo: "catalogo" } satisfies ScrollState) : undefined,
        });
      } else {
        const search = next.toString();
        navigate({ pathname: "/", search: search ? `?${search}` : "" }, { state: { scrollTo: "catalogo" } satisfies ScrollState });
      }
    },
    [onHome, params, setParams, navigate],
  );

  const goToSection = useCallback(
    (id: string) => {
      if (onHome) scrollToId(id);
      else navigate("/", { state: { scrollTo: id } satisfies ScrollState });
    },
    [onHome, navigate],
  );

  return { q, cat, update, goToSection };
}

