                        {inst.count} cuotas sin interés de {formatInstallment(inst.amount)}
                      </p>
                      <p className="text-[13px] text-ink">
                        Total {formatPrice(product.price ?? 0)}. {settings.installments_conditions}
                      </p>
                    </div>
                  </div>
                )}
                {cash != null && (
                  <div className="flex gap-3">
                    <Banknote className="mt-0.5 size-5 shrink-0 text-brand" aria-hidden="true" />
                    <div className="text-sm">
                      <p className="font-bold text-brand">
                        {formatPrice(cash)} en efectivo ({settings.cash_discount_percent}% off)
                      </p>
                      <p className="text-[13px] text-ink">{settings.cash_discount_conditions}</p>
                    </div>
                  </div>
                )}
              </div>
            )}
          </div>
        </aside>
      </div>

      {related.length > 0 && (
        <section aria-labelledby="related-title" className="mt-20 border-t border-beige pt-12" data-testid="related-products-section">
          <SectionHeading
            id="related-title"
            eyebrow="Para complementar"
            title="Productos relacionados"
            description={category ? `Más soluciones de ${category.name.toLowerCase()} y productos compatibles.` : undefined}
          />
          <div className="mt-8 grid grid-cols-2 gap-3 sm:gap-6 lg:grid-cols-4">
            {related.map((p) => (
              <ProductCard key={p.id} product={p} category={byId.get(p.category_id)} settings={settings} testIdPrefix="related-card" />
            ))}
          </div>
        </section>
      )}

      {/* Mobile sticky purchase bar */}
      <div className="fixed inset-x-0 bottom-0 z-30 border-t border-beige bg-cream/95 px-4 py-3 backdrop-blur-md lg:hidden">
        <div className="mx-auto flex max-w-7xl items-center gap-3">
          <div className="min-w-0 flex-1">
            <p className="truncate text-xs text-ink">{product.name}</p>
            <p className="text-lg font-bold text-brand tabular-nums">
              {product.price != null ? formatPrice(product.price) : "Consultar precio"}
            </p>
          </div>
          <WhatsAppButton settings={settings} productName={product.name} size="md" className="h-12" testId="product-sticky-whatsapp-button">
            Consultar
          </WhatsAppButton>
        </div>
      </div>
    </div>
  );
}

import { useEffect, useMemo, useRef } from "react";
import { useLocation } from "react-router-dom";
import { categoryMap, useCatalog } from "@/lib/catalog";
import { scrollToId, useCatalogParams, type ScrollState } from "@/lib/useCatalogParams";
import { BestSellersCarousel } from "@/components/catalog/BestSellersCarousel";
import { DemoNotice, HowToBuy, PromoStrip } from "@/components/catalog/HomeSections";
import { CatalogExplorer } from "@/components/catalog/CatalogExplorer";

export default function Home() {
  const { data, isLoading, isError, refetch } = useCatalog();
  const location = useLocation();
  const { q } = useCatalogParams();
  const prevQ = useRef(q);

  const products = useMemo(() => (isError ? [] : (data?.products ?? [])), [data, isError]);
  const categories = useMemo(() => data?.categories ?? [], [data]);
  const byId = useMemo(() => categoryMap(categories), [categories]);
  const settings = data?.settings;

  useEffect(() => {
    document.title = "CASANOVA · Tecnología para el hogar | Catálogo";
  }, []);

  // Header links / category picks from other pages ask to scroll to a section.
  useEffect(() => {
    const target = (location.state as ScrollState | null)?.scrollTo;
    if (target) window.setTimeout(() => scrollToId(target), 60);
  }, [location.key, location.state]);

  // When the user starts typing in the header search, bring the results into view.
  useEffect(() => {
    if (!prevQ.current && q) {
      const el = document.getElementById("catalogo");
      const r = el?.getBoundingClientRect();
      if (r && (r.top > 200 || r.bottom < 200)) scrollToId("catalogo");
    }
    prevQ.current = q;
  }, [q]);

  return (
    <div className="space-y-12 sm:space-y-20" data-testid="home-page">
      <h1 className="sr-only">CASANOVA · Catálogo de tecnología para el hogar</h1>

      <BestSellersCarousel products={products} categories={byId} settings={settings} isLoading={isLoading} />

      {settings && <PromoStrip settings={settings} />}

      <div className="space-y-6 sm:space-y-8">
        {settings?.show_demo_notice && <DemoNotice />}
        <CatalogExplorer
          products={products}
          categories={categories}
          categoryById={byId}
          settings={settings}
          isLoading={isLoading}
          isError={isError}
          onRetry={() => void refetch()}
        />
      </div>

      <HowToBuy settings={settings} />
    </div>
  );
}

import { Link } from "react-router-dom";

export default function NotFound() {
  return (
    <div className="mx-auto flex max-w-7xl flex-col items-start gap-4 px-4 py-20 sm:px-6 lg:px-8" data-testid="not-found-page">
      <p className="text-xs font-semibold uppercase tracking-[0.18em] text-brand">Error 404</p>
      <h1 className="text-3xl font-extrabold text-brand sm:text-4xl">Esta página no existe.</h1>
      <p className="text-ink">Volvé al catálogo para seguir explorando nuestros productos.</p>
      <Link
        to="/"
        data-testid="not-found-home-link"
        className="inline-flex h-11 items-center rounded-xl bg-brand px-5 text-sm font-semibold text-cream transition-colors hover:bg-ink"
      >
        Ir al catálogo
      </Link>
    </div>
  );
}
