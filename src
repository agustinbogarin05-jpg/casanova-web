            collapse > 0 && "pointer-events-none opacity-0",
          )}
        >
          <Logo fluid />
        </div>

        <nav aria-label="Navegación principal" className="hidden items-center gap-0.5 lg:flex">
          <DropdownMenu>
            <DropdownMenuTrigger className={navLink} data-testid="header-categories-trigger">
